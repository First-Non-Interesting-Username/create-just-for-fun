{
  "name": "Create: Just for Fun developement",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu@sha256:1f8bb87ca6d342a587a9163a5a1ea8c487bcd4f149e8483a5ff711f795f0776d",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/workspaces/create-just-for-fun/.devcontainer/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "WakaTime.vscode-wakatime",
        "tamasfe.even-better-toml",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y && go install github.com/packwiz/packwiz@latest"
}